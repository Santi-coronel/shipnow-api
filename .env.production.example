# ShipNow API - variables para produccion (o para docker run --env-file)
# Copia este archivo con otro nombre (ej. .env.production) y completa los valores reales.
# Ese archivo NO se sube a Git ni entra en la imagen de Docker.

NODE_ENV=production
PORT=8080

# En Docker con compose: mongodb://mongo:27017/shipnow. En Atlas: mongodb+srv://...
MONGODB_URI=mongodb+srv://USUARIO:PASSWORD@CLUSTER.mongodb.net/shipnow

LOG_LEVEL=info
UPLOADS_DIR=/app/uploads
PUBLIC_URL=https://tu-dominio.com

# En produccion Swagger viene apagado; poner true solo si se quiere dejarlo accesible
ENABLE_DOCS=false
