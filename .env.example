# ShipNow API - variables de entorno
# Copia este archivo como ".env" y completa los valores. El .env NO se sube a Git.
# Para produccion se usa un archivo aparte (ver .env.production.example) o las variables del servidor.

# Puerto del servidor (default: 8080)
PORT=8080

# URI de MongoDB (obligatoria; si falta o es invalida la app no arranca)
# Local: mongodb://localhost:27017/shipnow
# Atlas: mongodb+srv://usuario:password@cluster.../shipnow
MONGODB_URI=mongodb://localhost:27017/shipnow

# Entorno: development | test | production
NODE_ENV=development

# Nivel minimo de logs: debug | http | info | warning | error | fatal
# Default: debug en desarrollo, info en produccion
LOG_LEVEL=debug

# Carpeta donde se guardan los archivos subidos (default: uploads, no se sube a Git)
UPLOADS_DIR=uploads

# URL publica de la API; se usa en Swagger (default: http://localhost:PORT)
PUBLIC_URL=http://localhost:8080

# Solo en produccion: true para dejar Swagger disponible (default: false)
# ENABLE_DOCS=false
