# ============================================================
# SHIPNOW API — VARIABLES DE ENTORNO
# ============================================================
#
# 1. Copia este archivo y renombralo a ".env"
# 2. Completa los valores con tu configuracion real
# 3. NUNCA subas el archivo .env a Git (ya esta en .gitignore)
# ============================================================

# Puerto del servidor (default: 8080)
PORT=8080

# URI de conexion a MongoDB (obligatoria, la app no arranca sin esto)
# Local: mongodb://localhost:27017/shipnow-dev
# Atlas: mongodb+srv://usuario:password@cluster.../shipnow
MONGODB_URI=mongodb://localhost:27017/shipnow

# Entorno de ejecucion: development | test | production
NODE_ENV=development

# Nivel minimo de logs que se muestran por consola/archivo (opcional)
# Valores: debug | http | info | warning | error | fatal
LOG_LEVEL=debug
